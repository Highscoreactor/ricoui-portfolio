---
import { ArrowUpRight, CalendarDays, Check, Github, Pipette } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Explore from "@/components/sections/Explore.astro";
import { siteConfig } from "@/config/site";

const works = [
  {
    title: "Blender Ocean",
    description: "Blender Practice Room",
    image: "/assets/figma-home/work-1.webp",
    tags: ["Modeling", "Rendering", "Learning Reflections"],
    href: "/works",
    wide: true,
  },
  {
    title: "My Photography",
    description: "Visual Diary",
    image: "/assets/figma-home/work-2.webp",
    tags: ["Street Photography", "Landscape", "..."],
    href: "/works",
    wide: true,
  },
  {
    title: "365 Posters Practice",
    description: "Posters Design Resources & Assets",
    image: "/assets/figma-home/work-3.webp",
    tags: ["Daily Poster", "Typography", "Composition Study"],
    href: "/works",
    wide: true,
  },
  {
    title: "InspoWeb",
    description: "Web Inspiration Library",
    image: "/assets/figma-home/work-4.webp",
    tags: ["Inspiration", "Web Collections", "Label"],
    href: "https://inspoweb.com",
    wide: false,
  },
  {
    title: "UIUXDECK",
    description: "Design Resources & Tools",
    image: "/assets/figma-home/work-5.webp",
    tags: ["Design", "Tools", "Resources"],
    href: "https://uiuxdeck.com",
    wide: false,
  },
];

const articles = [
  {
    image: "/assets/figma-home/blog-1.webp",
    title: "What Is Dreamcore Aesthetics? AI Is Making Every Individual a Dream Maker",
  },
  {
    image: "/assets/figma-home/blog-2.webp",
    title: "What Is Dreamcore Aesthetics? AI Is Making Every Individual a Dream Maker",
  },
  {
    image: "/assets/figma-home/blog-3.webp",
    title: "What Is Dreamcore Aesthetics? AI Is Making Every Individual a Dream Maker",
  },
];
---

<Layout
  title="Highscoreactor - Designer Portfolio"
  description="Designer portfolio featuring selected work, experiments, tools and writing."
>
  <main class="home">
    <section class="hero site-container">
      <div class="hero-copy">
        <h1>Hi, I'm<br />Highscoreactor.</h1>
        <p>
          I'm a designer with 5+ years of experience. I love blending design and code to create
          captivating visuals and interactive experiences.
        </p>
        <p>I believe great design should be both delightful and solve real-world challenges.</p>
        <a class="primary-action" href="#explore">Let's go</a>
        <a class="social-tile" href={siteConfig.social.github} target="_blank" aria-label="GitHub">
          <Github size={22} />
          <span>Github<small>@highscoreactor</small></span>
        </a>
      </div>

      <div class="hero-art" aria-label="The Vantage Point gallery concept">
        <span class="selection-label">The Vantage Point</span>
        <span class="selection-handle handle-a"></span>
        <span class="selection-handle handle-b"></span>
        <span class="selection-handle handle-c"></span>
        <span class="selection-handle handle-d"></span>
        <div class="gallery-board">
          <div class="gallery-controls">
            <div class="focus-square"><span></span></div>
            <button type="button">ENTER</button>
          </div>
          <img src="/assets/figma-home/hero-a.webp" alt="Orange flowers in a garden" />
        </div>
        <div class="type-badge"><span>TT</span> Gallery <Check size={16} /></div>
        <div class="color-tool">
          <span><Pipette size={17} /></span>
          <div>
            <i class="rainbow"></i>
            <i class="alpha"></i>
          </div>
        </div>
      </div>
    </section>

    <section id="explore" class="section-block explore-block">
      <h2>Explore ↓</h2>
      <Explore />
    </section>

    <section class="section-block works-section">
      <header class="section-heading">
        <h2>Featured Work ↓</h2>
        <p>
          I create innovative and purposeful designs that not only capture attention but also drive
          meaningful results. (Just imagined now~~)
        </p>
      </header>

      <div class="works-grid site-container">
        {works.map((work) => (
          <article class:list={["work-card", work.wide && "work-card--wide"]}>
            <a href={work.href} target={work.href.startsWith("http") ? "_blank" : undefined}>
              <div class="work-image"><img src={work.image} alt={work.title} loading="lazy" /></div>
              <div class="work-copy">
                <h3>{work.title}</h3>
                <div class="tags">{work.tags.map((tag) => <span>{tag}</span>)}</div>
                <p>{work.description}</p>
                <span class="round-link"><ArrowUpRight size={15} /></span>
              </div>
            </a>
          </article>
        ))}
      </div>
      <a class="outline-action" href="/works">See All Works</a>
    </section>

    <section class="section-block articles-section">
      <header class="section-heading">
        <h2>Latest Articles ↓</h2>
        <p>These are my notes and articles on design, development and life thinking.</p>
      </header>
      <div class="articles-grid site-container">
        {articles.map((article) => (
          <article class="article-card">
            <a href="/blog">
              <img src={article.image} alt="" loading="lazy" />
              <div class="article-meta"><CalendarDays size={14} /> Sep 19, 2025 <span>•</span><b>Dreamcore</b></div>
              <h3>{article.title}</h3>
              <p>{article.title}</p>
              <span class="read-more">Read More →</span>
            </a>
          </article>
        ))}
      </div>
      <a class="outline-action" href="/blog">See All Works</a>
    </section>
  </main>
</Layout>

<style>
  .home { position: relative; z-index: 10; }
  .hero {
    display: grid;
    grid-template-columns: 430px 575px;
    justify-content: space-between;
    align-items: center;
    min-height: 790px;
    padding-top: 70px;
    padding-bottom: 90px;
  }
  .hero-copy { align-self: center; }
  .hero-copy h1, .section-block > h2, .section-heading h2, .work-copy h3, .article-card h3 {
    font-family: var(--font-brand);
    font-weight: 400;
    letter-spacing: 0;
  }
  .hero-copy h1 { font-size: 48px; line-height: 1.18; margin: 0 0 40px; }
  .hero-copy p { max-width: 430px; margin: 0 0 18px; color: #3f4a5a; font-size: 16px; line-height: 1.55; }
  .primary-action {
    display: flex; align-items: center; justify-content: center; width: 200px; height: 48px;
    margin-top: 66px; border-radius: 8px; background: #2d6dc3; color: white; font-size: 14px; font-weight: 600;
  }
  .social-tile {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; width: 82px; height: 82px;
    margin: 70px 0 0 4px; padding: 11px; border-radius: 10px; background: #10131c; color: white;
    box-shadow: 8px -4px 0 #42a5f5, 12px -1px 0 #ff5b8a; transform: rotate(-1deg);
  }
  .social-tile span { font-size: 7px; line-height: 1.2; }
  .social-tile small { display: block; margin-top: 3px; font-size: 5px; color: #cdd3df; }
  .hero-art { position: relative; width: 575px; height: 575px; border: 2px solid #4793ff; padding: 10px; }
  .selection-label { position: absolute; z-index: 5; top: -24px; left: 32px; padding: 4px 8px; background: #2d6dc3; color: white; font-size: 12px; }
  .selection-handle { position: absolute; z-index: 6; width: 10px; height: 10px; background: white; border: 2px solid #4793ff; }
  .handle-a { left: -6px; top: -6px; } .handle-b { right: -6px; top: -6px; }
  .handle-c { left: -6px; bottom: -6px; } .handle-d { right: -6px; bottom: -6px; }
  .gallery-board {
    display: grid; grid-template-columns: 145px 1fr; align-items: center; gap: 38px; width: 100%; height: 100%;
    padding: 58px 52px; border-radius: 18px; background: #fff6dc; box-shadow: 0 14px 30px rgba(83, 72, 39, .08);
  }
  .gallery-board img { width: 280px; height: 280px; object-fit: cover; border-radius: 3px; }
  .gallery-controls { display: flex; flex-direction: column; align-items: center; gap: 36px; }
  .focus-square { display: grid; place-items: center; width: 132px; height: 132px; border-radius: 3px; background: #59ad8d; }
  .focus-square span { width: 30px; height: 30px; border: 2px dashed #f4e83d; }
  .gallery-controls button { width: 132px; height: 40px; border: 2px solid #59ad8d; border-radius: 3px; color: #59ad8d; font-size: 22px; font-weight: 700; background: transparent; }
  .type-badge, .color-tool { position: absolute; z-index: 8; background: white; box-shadow: 0 10px 24px rgba(55, 68, 92, .16); }
  .type-badge { left: -16px; bottom: 32px; display: flex; align-items: center; gap: 8px; padding: 11px 14px; border-radius: 9px; color: #43a17e; font-family: var(--font-brand); font-size: 20px; }
  .type-badge span { color: #96a3bc; }
  .color-tool { right: -12px; bottom: 105px; display: flex; gap: 10px; width: 270px; padding: 10px 12px; border-radius: 12px; }
  .color-tool > span { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; background: #58af8f; color: white; }
  .color-tool > div { display: grid; flex: 1; gap: 8px; }
  .color-tool i { display: block; height: 10px; border-radius: 10px; }
  .rainbow { background: linear-gradient(90deg,#f00,#ff0,#0c6,#0cf,#70f,#f09); }
  .alpha { background: repeating-conic-gradient(#ddd 0 25%,white 0 50%) 0/8px 8px; border: 1px solid #ddd; }
  .section-block { padding-top: 70px; }
  .section-block > h2, .section-heading h2 { margin: 0; text-align: center; color: #2d6dc3; font-size: 44px; line-height: 1.1; }
  .explore-block { padding-top: 4px; }
  .explore-block :global(section) { padding-top: 60px; padding-bottom: 100px; }
  .explore-block :global(section > div:first-child) { display: none; }
  .explore-block :global([data-aos]) { opacity: 1 !important; transform: none !important; }
  .works-section { padding-top: 72px; }
  .section-heading { max-width: 610px; margin: 0 auto 88px; text-align: center; }
  .section-heading p { margin: 34px auto 0; font-size: 16px; line-height: 1.6; color: #4f5a6d; }
  .works-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 38px 20px; }
  .work-card { min-width: 0; border: 1px solid #cfe0f7; border-radius: 14px; background: rgba(255,255,255,.4); overflow: hidden; }
  .work-card--wide { grid-column: 1 / -1; }
  .work-card a { display: block; padding: 18px; color: inherit; }
  .work-image { overflow: hidden; width: 100%; aspect-ratio: 16 / 9; border-radius: 12px; background: #eef2f7; }
  .work-card:not(.work-card--wide) .work-image { aspect-ratio: 1.55 / 1; }
  .work-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .work-card:hover .work-image img { transform: scale(1.015); }
  .work-copy { position: relative; padding: 18px 4px 8px; }
  .work-copy h3 { margin: 0 0 13px; color: #2d6dc3; font-size: 28px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tags span, .article-meta b { padding: 6px 12px; border: 1px solid #cfe0f7; border-radius: 999px; color: #2d6dc3; font-size: 11px; font-weight: 400; }
  .work-copy p { margin: 16px 0 0; color: #677487; font-family: var(--font-brand); font-size: 16px; }
  .round-link { position: absolute; right: 0; top: 18px; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #e6f0ff; color: #2d6dc3; }
  .outline-action { display: flex; align-items: center; justify-content: center; width: 240px; height: 48px; margin: 68px auto 0; border: 1px solid #cfe0f7; border-radius: 8px; color: #3f4a5a; font-size: 14px; }
  .articles-section { padding-top: 190px; }
  .articles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .article-card { border: 1px solid #a9c9f4; border-radius: 14px; overflow: hidden; background: rgba(255,255,255,.45); }
  .article-card a { display: block; padding: 14px; color: inherit; }
  .article-card img { width: 100%; aspect-ratio: 1.55 / 1; object-fit: cover; border-radius: 10px; }
  .article-meta { display: flex; align-items: center; gap: 7px; margin-top: 18px; color: #92a1b7; font-size: 11px; }
  .article-meta b { padding: 5px 12px; }
  .article-card h3 { margin: 17px 0 12px; color: #2d6dc3; font-size: 23px; line-height: 1.25; }
  .article-card p { min-height: 44px; margin: 0; color: #677487; font-size: 13px; line-height: 1.45; }
  .read-more { display: block; margin-top: 30px; color: #2d6dc3; font-size: 13px; font-weight: 600; }
  .articles-section > .outline-action { margin-top: 70px; }
  :global(.home + section) { margin-top: 165px !important; }

  @media (max-width: 1000px) {
    .hero { grid-template-columns: 1fr; gap: 80px; min-height: auto; padding-top: 80px; }
    .hero-copy { max-width: 560px; margin-inline: auto; text-align: center; }
    .hero-copy p { margin-inline: auto; }
    .primary-action, .social-tile { margin-left: auto; margin-right: auto; }
    .hero-art { margin-inline: auto; }
  }
  @media (max-width: 720px) {
    .hero { width: calc(100% - 32px); padding: 42px 0 90px; }
    .hero-copy h1 { font-size: 42px; margin-bottom: 28px; }
    .hero-copy p { font-size: 15px; }
    .primary-action { margin-top: 42px; }
    .social-tile { margin-top: 48px; }
    .hero-art { width: 100%; height: auto; aspect-ratio: 1 / 1; padding: 6px; }
    .gallery-board { grid-template-columns: 32% 1fr; gap: 18px; padding: 28px 22px; }
    .gallery-board img { width: 100%; height: auto; aspect-ratio: 1 / 1; }
    .focus-square { width: 100%; height: auto; aspect-ratio: 1 / 1; }
    .gallery-controls button { width: 100%; height: 34px; font-size: 14px; }
    .color-tool { right: -4px; bottom: 18%; width: 52%; transform: scale(.82); transform-origin: right; }
    .type-badge { left: -6px; bottom: 4%; transform: scale(.8); transform-origin: left; }
    .section-block > h2, .section-heading h2 { font-size: 36px; }
    .explore-block :global(section) { padding-top: 38px; padding-bottom: 60px; }
    .section-heading { width: calc(100% - 32px); margin-bottom: 48px; }
    .works-grid, .articles-grid { grid-template-columns: 1fr; width: calc(100% - 32px); }
    .work-card { grid-column: auto; }
    .work-card a { padding: 10px; }
    .work-copy h3 { padding-right: 48px; font-size: 25px; }
    .articles-section { padding-top: 120px; }
    :global(.home + section) { margin-top: 110px !important; }
  }
</style>
