---
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import HeroCard from "@/components/home/HeroCard.astro";
import Layout from "@/layouts/Layout.astro";
import FeaturedWork from "@/components/sections/FeaturedWork.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import SocialCard from "@/components/cards/SocialCard.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import Explore from "@/components/sections/Explore.astro";
---

<Layout
  title="Fly-Fire Site 2026"
  description="Welcome to Flyfire's portfolio site! Explore my work as an E-Commerce/UI designer with 5+ years of experience in creating captivating visuals and interactive experiences."
  keywords="Fly-Fire, Portfolio, E-Commerce Design, UI Design, Frontend Development, Creative Designer"
>
  <main>
    <section class="home-hero site-container">
      <div class="home-hero__copy">
        <h1>
          <AnimatedText
            content="Hi, I'm Highscoreactor"
            delay={0.1}
            duration={0.5}
            stagger={0.08}
            class="home-hero__title font-brand"
          />
        </h1>

        <div class="home-hero__body">
          <AnimatedText
            content="I'm an E-Commerce/UI designer with 5+ years of experience. I love blending design and code to create captivating visuals and interactive experiences."
            delay={0.3}
            duration={0.5}
            stagger={0.015}
            class="text-base text-neutral-700 dark:text-neutral-300"
          />
        </div>

        <div class="home-hero__body">
          <AnimatedText
            content="I believe great design should be both delightful and solve real-world challenges."
            delay={0.5}
            duration={0.5}
            stagger={0.015}
            class="text-base text-neutral-700 dark:text-neutral-300"
          />
        </div>

        <div
          class="home-hero__action"
          data-aos="fade-up-sm"
          data-aos-delay="900"
          data-aos-duration="500"
          data-aos-once="true"
        >
          <Button url={siteConfig.social.twitter} type="fill" className="max-w-[200px]">
            Let's go
          </Button>
        </div>

        <div
          class="home-hero__social"
          data-aos="fade-up-sm"
          data-aos-delay="1000"
          data-aos-duration="600"
          data-aos-once="true"
        >
          <SocialCard displaySocialIds={[1, 2, 3, 4]} />
        </div>
      </div>

      <div
        class="home-hero__visual"
        data-aos="fade-left-sm"
        data-aos-delay="300"
        data-aos-duration="800"
        data-aos-once="true"
      >
        <HeroCard
          imageUrl="/assets/home/gradient-site.jpg"
          title="gradient-design"
          link="https://gradient-design-site.pages.dev/"
        />
      </div>
    </section>

    <div class="home-section" data-aos="fade-up-sm" data-aos-duration="600" data-aos-once="true">
      <Explore title={"Explore \u2193"} />
    </div>

    <div class="home-section" data-aos="fade-up-sm" data-aos-duration="600" data-aos-once="true">
      <FeaturedWork
        title={"Featured Work \u2193"}
        description="I create innovative and purposeful designs that not only capture attention but also drive meaningful results."
        limit={5}
      />
    </div>

    <div
      class="home-section home-section--articles"
      data-aos="fade-up-sm"
      data-aos-duration="600"
      data-aos-once="true"
    >
      <BlogSection
        title={"Latest Articles \u2193"}
        description="These are my notes and articles on design, development and life thinking."
        showViewAllButton={true}
      />
    </div>
  </main>
</Layout>

<style>
  .home-hero {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(420px, 1.14fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7.5rem);
    min-height: 780px;
    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  .home-hero__copy {
    min-width: 0;
    width: 100%;
    max-width: 430px;
  }

  .home-hero__copy h1 {
    margin-bottom: 1.25rem;
  }

  :global(.home-hero__title) {
    display: block;
    color: var(--color-text-primary);
    font-size: clamp(3.5rem, 4.4vw, 4rem);
    line-height: 0.98;
  }

  .home-hero__body {
    margin-bottom: 0.65rem;
    line-height: 1.65;
  }

  .home-hero__action {
    margin-top: 1.75rem;
  }

  .home-hero__social {
    margin-top: 2rem;
  }

  .home-hero__visual {
    position: relative;
    display: flex;
    min-width: 0;
    width: 100%;
    justify-content: flex-end;
  }

  .home-section {
    margin-top: 3rem;
  }

  .home-section--articles {
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
      gap: 4rem;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .home-hero__copy {
      max-width: 560px;
      margin-inline: auto;
      text-align: center;
    }

    .home-hero__action {
      display: flex;
      justify-content: center;
    }

    .home-hero__visual {
      max-width: 620px;
      margin-inline: auto;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .home-hero {
      width: calc(100vw - 2rem);
      max-width: calc(100vw - 2rem);
      gap: 3rem;
      margin-inline: auto;
      padding-inline: 0;
      padding-top: 2.5rem;
      padding-bottom: 2rem;
    }

    :global(.home-hero__title) {
      font-size: clamp(2.25rem, 10vw, 2.75rem);
    }

    .home-section {
      margin-top: 1rem;
    }
  }
</style>
